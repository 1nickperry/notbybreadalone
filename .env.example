TEXTLINK_API_KEY=your_textlink_api_key
# TextLink SIM id for the device that sends the text (Devices console).
SIM_CARD_ID=
# Optional single recipient for dry-run/testing. International format, for example +15551234567
RECIPIENT_PHONE=

# Optional Apps Script / webhook URL for subscribe/unsubscribe activity log
GOOGLE_SHEETS_WEBHOOK_URL=

# Test mode: allow 5-minute interval slots (e.g. "1:05 PM") for testing with temp SMS numbers
# Set to "1" or "true" to enable. Leave unset or blank for production (hourly slots only).
# DV_TEST_MODE=
